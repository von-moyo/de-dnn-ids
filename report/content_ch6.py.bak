"""Sections 4.6 and 4.7.

4.6 reports the final model, trained on the full class-capped corpus.
4.7 compares it against the smaller stage-one model, because the difference
between the two is itself a result.
"""
import json
import os

HERE = os.path.dirname(os.path.abspath(__file__))
F = json.load(open(os.path.join(HERE, "final", "metrics.json")))
S = json.load(open(os.path.join(HERE, "stage1", "metrics.json")))

FINAL_PERCLASS = [
    ("Benign", 0.84, 0.71, 0.77, 40000),
    ("Bot", 1.00, 1.00, 1.00, 28907),
    ("Brute Force -Web", 1.00, 0.48, 0.65, 113),
    ("Brute Force -XSS", 1.00, 0.52, 0.69, 46),
    ("DDOS attack-HOIC", 1.00, 1.00, 1.00, 39772),
    ("DDOS attack-LOIC-UDP", 0.90, 0.99, 0.94, 346),
    ("DDoS attacks-LOIC-HTTP", 1.00, 1.00, 1.00, 40000),
    ("DoS attacks-GoldenEye", 1.00, 1.00, 1.00, 8281),
    ("DoS attacks-Hulk", 1.00, 1.00, 1.00, 29040),
    ("DoS attacks-Slowloris", 1.00, 0.99, 1.00, 1982),
    ("Infilteration", 0.61, 0.77, 0.68, 23697),
    ("SSH-Bruteforce", 1.00, 1.00, 1.00, 18810),
]

# (class, stage-1 F1, stage-2 F1)
F1_SHIFT = [
    ("Benign", 0.66, 0.77),
    ("Brute Force -XSS", 0.65, 0.69),
    ("DDOS attack-LOIC-UDP", 0.99, 0.94),
    ("Infilteration", 0.77, 0.68),
    ("Brute Force -Web", 0.80, 0.65),
]


def sec46():
    L = []
    A = L.append
    A(("h2", "4.6 \tPerformance of the Final Model"))
    A(("p", "The configuration in Table 4.6 was then trained at full scale. "
            "The class cap was raised from 20,000 to 200,000 records, which "
            "yields a corpus of 1,154,967 records: 692,979 for training, "
            "230,994 for validation and 230,994 held back for testing. No "
            "further searching was performed. The hyperparameters were loaded "
            "from the file the search had written, so that the only difference "
            "between this model and the one evaluated during the search is the "
            "quantity of data it was trained on."))
    A(("p", "As before, a ten per cent stratified slice of the training pool "
            "drove early stopping, and the test partition played no part in "
            "deciding when to halt or which weights to retain. Training ran for "
            "56 of a permitted 100 epochs; validation loss reached its minimum "
            "of 0.1352 at epoch 46, and the ten epochs that followed produced "
            "no improvement, so early stopping restored the epoch 46 weights. "
            "Figure 4.2 shows the learning curves."))
    A(("fig", ("Training and validation loss of the final DE-optimised network "
               "trained on the full class-capped corpus. Early stopping "
               "restored the weights from epoch 46, marked by the dashed line.",
               os.path.join(HERE, "final", "training_loss.png"), 5.6)))
    A(("p", "The two curves descend together and remain close throughout, with "
            "no divergence of the kind that would indicate the model had begun "
            "memorising its training data. Validation loss is essentially flat "
            "from about epoch 20 onward, moving only in the fourth decimal "
            "place, which indicates that the model had extracted what it could "
            "from the available features well before training stopped. The "
            "headline test results are given in Table 4.7."))
    A(("tbl", ("Test Set Performance of the Final DE-Optimised DNN",
               ["Metric", "Value", "Interpretation"],
               [["Accuracy", "%.4f" % F["accuracy"],
                 "Share of all test flows classified correctly"],
                ["Precision (macro)", "%.4f" % F["precision"],
                 "Reliability of the model's class assignments, averaged equally over classes"],
                ["Recall (macro)", "%.4f" % F["recall"],
                 "Share of each class the model recovers, averaged equally"],
                ["F1-score (macro)", "%.4f" % F["f1"],
                 "Harmonic mean of precision and recall, averaged equally over classes"],
                ["ROC-AUC (macro OVR)", "%.4f" % F["auc"],
                 "Separability of the classes across all decision thresholds"],
                ["False-positive rate (macro)", "%.4f" % F["fpr"],
                 "One-vs-rest false-positive rate averaged over all twelve classes"],
                ["Benign false-alarm rate", "%.4f" % F["benign_false_alarm_rate"],
                 "Share of genuinely benign flows assigned to some attack class"]],
               [2.0, 1.0, 3.0])))
    A(("p", "The last two rows of Table 4.7 disagree with one another, and that "
            "disagreement is the single most important result in this chapter."))
    A(("p", "The macro false-positive rate is 0.0072, which read on its own "
            "would suggest an exceptionally well-behaved detector. The benign "
            "false-alarm rate is 0.2938: very nearly thirty per cent of "
            "genuinely benign traffic is assigned to an attack class. Both "
            "figures are correct, and the gap between them is a property of how "
            "they are computed. The macro false-positive rate is a one-vs-rest "
            "quantity averaged over twelve classes, and ten of those twelve "
            "attract almost no false positives at all, so the average is "
            "dominated by the easy cases and the single serious failure is "
            "diluted almost out of existence."))
    A(("p", "This matters well beyond bookkeeping. Chapter One motivated this "
            "work partly through alert fatigue, the documented tendency of "
            "security analysts to stop attending to a detector that raises too "
            "many false alarms. A system that flagged thirty per cent of benign "
            "traffic would be unusable in an operational setting, and the "
            "metric this literature conventionally reports conceals that "
            "completely. The benign false-alarm rate was added to the "
            "evaluation specifically because the conventional figure proved "
            "misleading here."))
    A(("p", "The per-class breakdown in Table 4.8 locates the problem "
            "precisely."))
    A(("tbl", ("Per-Class Performance of the Final Model on the Test Set",
               ["Class", "Precision", "Recall", "F1-score", "Support"],
               [[c, "%.2f" % p, "%.2f" % r, "%.2f" % f, "{:,}".format(s)]
                for c, p, r, f, s in FINAL_PERCLASS]
               + [["Macro average", "%.2f" % F["precision"],
                   "%.2f" % F["recall"], "%.2f" % F["f1"], "230,994"]],
               [2.3, 0.9, 0.9, 0.9, 1.0])))
    A(("p", "Eight of the twelve classes are recognised essentially perfectly, "
            "with F1 at or above 0.99: botnet and SSH brute-force traffic, all "
            "three denial-of-service families and two of the three distributed "
            "denial-of-service families. These are high-volume attacks with "
            "distinctive flow signatures, and the model separates them from "
            "everything else without difficulty."))
    A(("p", "The two web brute-force classes achieve perfect precision with "
            "recall near one half, meaning the model is reliable when it "
            "commits to those classes but recovers only about half of their "
            "instances. With 113 and 46 test records respectively these are "
            "small-sample results and should not be over-interpreted. The "
            "substantive failure lies with Benign, at 0.71 recall, and "
            "Infilteration, at 0.61 precision. The confusion matrix in Figure "
            "4.3 shows why these two figures are really a single finding."))
    A(("fig", ("Confusion matrix of the final DE-optimised network on the "
               "held-out test set of 230,994 flows. The two dominant "
               "off-diagonal cells are benign traffic classified as "
               "Infiltration and the reverse.",
               os.path.join(HERE, "final", "confusion_matrix.png"), 6.2)))
    A(("p", "The model made 17,524 errors across 230,994 test flows, an overall "
            "error rate of 7.59 per cent. Table 4.9 sets out where they fall."))
    A(("tbl", ("Distribution of Classification Errors in the Final Model",
               ["True class", "Predicted as", "Errors", "Share of errors (%)"],
               [["Benign", "Infilteration", "11,657", "66.5"],
                ["Infilteration", "Benign", "5,461", "31.2"],
                ["Benign", "Bot", "59", "0.3"],
                ["Infilteration", "Bot", "49", "0.3"],
                ["DDoS attacks-LOIC-HTTP", "DDOS attack-LOIC-UDP", "37", "0.2"],
                ["Brute Force -Web", "Benign", "33", "0.2"],
                ["All remaining confusions combined", "not applicable", "228", "1.3"],
                ["Total", "not applicable", "17,524", "100.0"]],
               [2.1, 1.8, 0.9, 1.3])))
    A(("p", "The two directions of the Benign and Infiltration confusion "
            "together account for 17,118 of the 17,524 errors, or 97.7 per cent "
            "of everything the model gets wrong. Every other misclassification "
            "in a twelve-class problem, taken together, accounts for the "
            "remaining 2.3 per cent. The equivalent figure during the search, "
            "on a corpus one-sixth the size, was 93.6 per cent, so enlarging "
            "the training data concentrated the error further rather than "
            "dispersing it."))
    A(("p", "This is a property of the data rather than a failing of the "
            "architecture, and it is consistent with what is known about this "
            "dataset. Infiltration in CSE-CIC-IDS2018 consists of an attacker "
            "operating from inside the network using ordinary protocols; at the "
            "level of flow statistics, which is all the model can observe, it "
            "is close to indistinguishable from ordinary internal traffic. A "
            "direct check on the corpus supports this reading: within a single "
            "capture file, 8,577 records were found to share an identical "
            "feature vector with a record carrying a different label. Where two "
            "records are identical in every feature and differ only in their "
            "label, no classifier of any architecture can assign both "
            "correctly. There is a floor beneath the achievable error, and this "
            "model sits close to it."))
    A(("p", "That finding also explains Section 4.5. If the loss is dominated "
            "by a class pair which is not separable in the available feature "
            "space, then the architecture of the network is very nearly "
            "irrelevant to the outcome, and an optimiser searching over "
            "architectures will encounter a flat surface. The two results are "
            "the same result observed from two directions."))
    return L


def sec47():
    L = []
    A = L.append
    A(("h2", "4.7 \tEffect of Sampling Ratio on Detection Behaviour"))
    A(("p", "Because the search was carried out on a corpus capped at 20,000 "
            "records per class and the final model was trained on one capped at "
            "200,000, two models exist that differ in nothing but the quantity "
            "and proportion of their training data. Comparing them was not part "
            "of the original design, but the comparison turned out to be "
            "informative and is reported here."))
    A(("tbl", ("Effect of Raising the Class Cap from 20,000 to 200,000",
               ["Metric", "Cap 20,000", "Cap 200,000", "Change"],
               [["Training records", "103,461", "692,979", "6.7 times"],
                ["Accuracy", "%.4f" % S["accuracy"], "%.4f" % F["accuracy"],
                 "%+.4f" % (F["accuracy"] - S["accuracy"])],
                ["Precision (macro)", "%.4f" % S["precision"],
                 "%.4f" % F["precision"],
                 "%+.4f" % (F["precision"] - S["precision"])],
                ["Recall (macro)", "%.4f" % S["recall"], "%.4f" % F["recall"],
                 "%+.4f" % (F["recall"] - S["recall"])],
                ["F1-score (macro)", "%.4f" % S["f1"], "%.4f" % F["f1"],
                 "%+.4f" % (F["f1"] - S["f1"])],
                ["Benign false-alarm rate",
                 "%.4f" % S["benign_false_alarm_rate"],
                 "%.4f" % F["benign_false_alarm_rate"],
                 "%+.4f" % (F["benign_false_alarm_rate"]
                            - S["benign_false_alarm_rate"])]],
               [1.9, 1.3, 1.3, 1.3])))
    A(("p", "Training on 6.7 times as much data made the model substantially "
            "better in operational terms and slightly worse by the measure the "
            "search was optimising. The benign false-alarm rate fell from "
            "0.4788 to 0.2938, a reduction of thirty-nine per cent in the "
            "proportion of legitimate traffic wrongly flagged. Macro F1 fell "
            "from 0.9041 to 0.8923. Both movements have the same cause."))
    A(("p", "The class cap does not only control how much data there is; it "
            "also controls the ratio between classes. At a cap of 20,000, both "
            "Benign and Infiltration exceed the threshold and are cut to 20,000 "
            "records each, giving a prior of one to one. At a cap of 200,000, "
            "Benign reaches the cap at 200,000 records but Infiltration has "
            "only 118,483 in the whole corpus, so the prior becomes roughly "
            "1.69 to one in favour of Benign. A classifier trained under the "
            "second regime places its decision boundary differently, and the "
            "per-class figures follow exactly that prediction: benign recall "
            "rose from 0.52 to 0.71 while Infiltration recall fell from 0.93 to "
            "0.77."))
    A(("p", "Table 4.11 shows where the macro average lost ground."))
    A(("tbl", ("Per-Class F1 Changes Between the Two Training Regimes",
               ["Class", "F1 at cap 20,000", "F1 at cap 200,000", "Change"],
               [[c, "%.2f" % a, "%.2f" % b, "%+.2f" % (b - a)]
                for c, a, b in F1_SHIFT]
               + [["Macro average (all 12 classes)", "%.4f" % S["f1"],
                   "%.4f" % F["f1"], "%+.4f" % (F["f1"] - S["f1"])]],
               [2.4, 1.3, 1.3, 0.9])))
    A(("p", "Benign improved by 0.11 and Brute Force -XSS by 0.04, while "
            "Infiltration lost 0.09, DDOS attack-LOIC-UDP 0.05 and Brute Force "
            "-Web 0.15. The remaining seven classes were unchanged. Because the "
            "macro average weights a class of 113 test records identically to "
            "one of 200,000, the losses on the small classes outweigh the "
            "considerable gain on Benign, and the average moves down even "
            "though the model is more useful."))
    A(("p", "Two conclusions follow. The first is that the choice of sampling "
            "regime is not a neutral preprocessing decision on this dataset; it "
            "shifts the operating point of the resulting detector as surely as "
            "moving a decision threshold would, and any result reported on "
            "CSE-CIC-IDS2018 should state the regime used. The second concerns "
            "the objective itself. Macro F1 was chosen as the fitness signal in "
            "Section 4.4 to prevent the rare classes being ignored, and it "
            "serves that purpose. But it is not the same thing as operational "
            "quality, and this experiment produced a case where the two move in "
            "opposite directions. A search optimising macro F1 would have "
            "rejected the more useful of these two models."))
    return L
