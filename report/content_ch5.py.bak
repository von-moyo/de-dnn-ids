"""Section 4.7, Section 4.8 and Chapter 5.

Section 4.7 reads baseline/metrics.json when it exists. If the baseline run has
not been carried out, the section is emitted with an explicit marker rather
than with invented figures.
"""
import json
import os

from content_ch45 import m, cfg, hp, hist, gain, last_imp, plateau

HERE = os.path.dirname(os.path.abspath(__file__))
BASE = os.path.join(HERE, "baseline")

# `m` above is the stage-one model evaluated during the search. `FIN` is the
# final model trained on the full class-capped corpus, and it is the one the
# conclusions are drawn from.
FIN = json.load(open(os.path.join(HERE, "final", "metrics.json")))

BL = None
_p = os.path.join(BASE, "metrics.json")
if os.path.exists(_p):
    BL = json.load(open(_p))

MANUAL = {"n_layers": 2, "neurons": 128, "lr": 0.001, "dropout": 0.2,
          "batch": 64, "activation": "relu"}


def _delta(a, b):
    d = (a - b) * 100
    return "{:+.2f}".format(d)


def ch4_tail():
    S = []
    A = S.append
    A(("h2", "4.8 \tComparison with a Manually Configured Baseline"))
    A(("p", "The premise of this project is that an evolutionary search earns "
            "its cost, so the fair test is a comparison against a sensible "
            "network configured by hand, of the kind a practitioner might "
            "reach for without running any search at all. The baseline used "
            "here is a two-layer network of 128 neurons with a learning rate "
            "of 0.001, a dropout rate of 0.2, a batch size of 64 and ReLU "
            "activation. These are conventional defaults rather than an "
            "adversarially weak choice: they are the values that appear most "
            "often in the intrusion detection literature reviewed in Chapter "
            "Two."))
    A(("p", "The baseline was trained and evaluated through the identical "
            "pipeline, on the identical data, with the identical split and the "
            "identical random seed. The only difference between the two runs is "
            "the origin of the six hyperparameters. The comparison is made at "
            "the class cap of 20,000 used during the search rather than at the "
            "200,000 of Section 4.6, so that it isolates what the search itself "
            "contributed; Section 4.7 has already shown that changing the cap "
            "moves the operating point independently of any hyperparameter. "
            "Table 4.12 sets out the two configurations side by side."))
    A(("tbl", ("Configurations Compared",
               ["Hyperparameter", "Manual baseline", "DE-optimised"],
               [["Hidden layers", "2", str(hp["n_layers"])],
                ["Neurons per layer", "128", str(hp["neurons"])],
                ["Learning rate", "0.001000", "{:.6f}".format(hp["lr"])],
                ["Dropout rate", "0.200", "{:.3f}".format(hp["dropout"])],
                ["Batch size", "64", str(hp["batch"])],
                ["Activation function", "ReLU", hp["activation"]]],
               [2.0, 2.0, 2.0])))

    if BL is None:
        A(("p", "[[ PENDING: the baseline run has not yet been completed. Once "
                "baseline/metrics.json exists, this section is regenerated "
                "automatically with the measured figures. ]]"))
        return S + _discussion()

    rows = [
        ["Accuracy", "{:.4f}".format(BL["accuracy"]),
         "{:.4f}".format(m["accuracy"]),
         _delta(m["accuracy"], BL["accuracy"])],
        ["Precision (macro)", "{:.4f}".format(BL["precision"]),
         "{:.4f}".format(m["precision"]),
         _delta(m["precision"], BL["precision"])],
        ["Recall (macro)", "{:.4f}".format(BL["recall"]),
         "{:.4f}".format(m["recall"]), _delta(m["recall"], BL["recall"])],
        ["F1-score (macro)", "{:.4f}".format(BL["f1"]),
         "{:.4f}".format(m["f1"]), _delta(m["f1"], BL["f1"])],
        ["ROC-AUC (macro OVR)", "{:.4f}".format(BL["auc"]),
         "{:.4f}".format(m["auc"]), _delta(m["auc"], BL["auc"])],
        ["Benign false-alarm rate",
         "{:.4f}".format(BL["benign_false_alarm_rate"]),
         "{:.4f}".format(m["benign_false_alarm_rate"]),
         _delta(m["benign_false_alarm_rate"], BL["benign_false_alarm_rate"])],
    ]
    A(("tbl", ("Performance of the DE-Optimised Network against the Manual "
               "Baseline",
               ["Metric", "Manual baseline", "DE-optimised",
                "Difference (percentage points)"],
               rows, [1.8, 1.4, 1.4, 1.6])))

    df1 = (m["f1"] - BL["f1"]) * 100
    if abs(df1) < 1.0:
        A(("p", "The difference in macro F1 between the two models is {:.2f} "
                "percentage points. On the evidence of this experiment, the "
                "Differential Evolution search did not produce a materially "
                "better detector than a conventionally configured network. "
                "This is a negative result with respect to the project's "
                "original hypothesis, and it is reported as such."
                .format(df1)))
        A(("p", "It is, however, entirely consistent with everything else in "
                "this chapter. Section 4.5 established that the search surface "
                "is close to flat, and Section 4.6 established why: the error "
                "is dominated by a class pair that is not separable in the "
                "available features. A hand-picked configuration and an "
                "evolved configuration both run into the same ceiling, because "
                "the ceiling is a property of the data and not of the network. "
                "That the two land within a percentage point of one another is "
                "the expected outcome once that is understood, and it "
                "corroborates the explanation rather than undermining it."))
        A(("p", "The practical conclusion is not that hyperparameter "
                "optimisation is worthless, but that its value is contingent "
                "on the problem being architecture-limited in the first place. "
                "Establishing whether that condition holds, which this chapter "
                "does through the convergence curve and the confusion "
                "analysis, is a cheaper diagnostic than an extended search and "
                "ought to precede one."))
        A(("p", "One difference between the two runs does not appear in Table "
                "4.13 at all, and is worth recording because it favours the "
                "evolved configuration on grounds the fitness function never "
                "measured. The baseline's validation loss became unstable "
                "during training, rising from 0.1367 at epoch seven to 12.3978 "
                "by epoch seventeen while its validation accuracy held steady "
                "at approximately 0.93. A model whose accuracy is unchanged but "
                "whose cross-entropy has risen by two orders of magnitude is "
                "making a small number of extremely confident incorrect "
                "predictions. Early stopping contained the damage by restoring "
                "the epoch-seven weights, which is why the baseline still "
                "scores competitively in Table 4.13. The evolved configuration, "
                "with tanh activation, no dropout and a larger batch, showed no "
                "such behaviour and its validation loss declined monotonically "
                "to a plateau."))
        A(("p", "This suggests that the search selected for stability as much "
                "as for accuracy, since an unstable candidate would have been "
                "scored at whatever its early-stopped weights achieved and "
                "penalised accordingly. It is a real benefit of the "
                "optimisation, but it is not one macro F1 records, and it "
                "would have gone unnoticed had the training logs not been "
                "examined directly."))
    else:
        A(("p", "The Differential Evolution configuration improves macro F1 by "
                "{:.2f} percentage points over the manual baseline. The margin "
                "should be read alongside Section 4.5: the search improved on "
                "its own initial random population by only {:.2f} percentage "
                "points, so most of the difference recorded here reflects the "
                "distance between the manual configuration and a competent one "
                "rather than the work done by the evolutionary search itself."
                .format(df1, gain * 100)))
        A(("p", "Put differently, drawing ten random configurations from the "
                "same search space and keeping the best would have secured "
                "most of this improvement. That is a meaningful finding about "
                "the value of searching this particular space, and it is a "
                "more honest reading of the evidence than attributing the "
                "whole margin to Differential Evolution."))

    return S + _discussion()


def _discussion():
    """Section 4.8. Kept separate so it is emitted whether or not the baseline
    run exists, rather than being skipped by the early return above."""
    S = []
    A = S.append
    A(("h2", "4.9 \tDiscussion"))
    A(("p", "Four findings emerge from this chapter, and they reinforce one "
            "another."))
    A(("p", "The first is that the hyperparameter surface for this problem is "
            "flat. The search improved on a random initial population by "
            "{:.2f} per cent and stopped improving at generation {}, after "
            "which {} further generations produced nothing. Where a search "
            "converges that quickly and gains that little, the explanation is "
            "usually the objective rather than the optimiser."
            .format(100 * gain / hist[0], last_imp, plateau)))
    A(("p", "The second is that the objective is limited by the data. In the "
            "final model, 97.7 per cent of all classification error is a single "
            "confusion between benign traffic and the Infiltration class, and "
            "identical feature vectors carrying different labels were found in "
            "the corpus itself. Infiltration at the flow-statistics level is "
            "not reliably distinguishable from ordinary internal traffic, and "
            "no arrangement of layers and neurons changes that. This is the "
            "mechanism behind the first finding."))
    A(("p", "The third is that the sampling regime moves the detector's "
            "operating point. Raising the class cap from 20,000 to 200,000 cut "
            "the benign false-alarm rate from 0.4788 to 0.2938 while lowering "
            "macro F1 from 0.9041 to 0.8923, because the cap governs not only "
            "how much data there is but the ratio between classes, and the "
            "Benign to Infiltration prior moved from one-to-one to roughly "
            "1.69-to-one. A preprocessing choice thus altered detection "
            "behaviour more than the entire hyperparameter search did."))
    A(("p", "The fourth concerns measurement. The macro false-positive rate, "
            "the figure this literature conventionally reports, was 0.0072 for "
            "a model that misclassifies 29.4 per cent of benign traffic. Had "
            "the evaluation relied on the conventional metric alone, the "
            "central weakness of this model would not have appeared anywhere in "
            "the results at all. Worse, the two models compared in Section 4.7 "
            "are ranked in opposite orders by macro F1 and by the benign "
            "false-alarm rate, so the choice of metric determines not only "
            "whether a defect is visible but which model is judged better."))
    A(("p", "Taken together these point away from further architecture search "
            "and towards the data itself. The gains available from better "
            "features, from richer representations of a flow than the summary "
            "statistics CICFlowMeter produces, or from cost-sensitive training "
            "that prices a benign false alarm properly, are likely to be "
            "substantially larger than anything another thousand network "
            "trainings would yield."))
    return S


def ch5():
    S = []
    A = S.append
    A(("h1", "CHAPTER FIVE"))
    A(("h1", "SUMMARY, CONCLUSION AND RECOMMENDATIONS"))

    A(("h2", "5.1 \tSummary"))
    A(("p", "This project set out to determine whether pairing a deep neural "
            "network with an evolutionary optimiser produces a better network "
            "intrusion detector, on the premise that the performance of such a "
            "network depends heavily on hyperparameters which are usually "
            "chosen by hand and rarely chosen well."))
    A(("p", "Chapter One framed the problem and its motivation. Chapter Two "
            "reviewed the relevant ground, from the development of intrusion "
            "detection systems through the principal neural network "
            "architectures to the family of evolutionary algorithms, with "
            "particular attention to Differential Evolution. Chapter Three set "
            "out the methodology, following the machine learning development "
            "lifecycle from problem definition through data preparation and "
            "model design to evaluation. Chapter Four carried that design into "
            "a working implementation and applied it to CSE-CIC-IDS2018."))
    A(("p", "A Differential Evolution optimiser was implemented from first "
            "principles and used to search a six-dimensional hyperparameter "
            "space covering the depth and width of the network, its learning "
            "and dropout rates, its batch size and its activation function. "
            "Each candidate was scored by training a network and measuring its "
            "macro-averaged F1 on validation data, a choice made specifically "
            "to prevent the heavily imbalanced rare attack classes from being "
            "ignored. The search evaluated 110 networks across ten "
            "generations and settled on a four-layer network of 209 neurons "
            "using tanh activation, no dropout and a learning rate of "
            "0.00072."))
    A(("p", "The winning configuration was then retrained at full scale on "
            "692,979 records and evaluated once on a held-out test partition of "
            "230,994 flows spanning twelve classes. It achieved a macro F1 of "
            "{:.4f}, an accuracy of {:.4f} and a macro one-vs-rest ROC-AUC of "
            "{:.4f}, correctly identifying eight of the twelve classes with an "
            "F1 at or above 0.99."
            .format(FIN["f1"], FIN["accuracy"], FIN["auc"])))

    A(("h2", "5.2 \tConclusion"))
    A(("p", "The evidence gathered here does not support the project's "
            "original hypothesis in the form it was posed, and the more "
            "interesting conclusion lies in why."))
    A(("p", "Differential Evolution did find a working configuration, and did "
            "so quickly and reliably. It converged within four generations and "
            "produced a detector that identifies eight of twelve attack "
            "classes essentially perfectly. But it improved on its own random "
            "initial population by only {:.2f} per cent, and the six "
            "generations following convergence changed nothing at all. The "
            "hyperparameter surface for this problem is flat."
            .format(100 * gain / hist[0])))
    A(("p", "The reason is established in Section 4.6. In the final model, 97.7 "
            "per cent of all classification error is a single confusion between "
            "benign traffic and the Infiltration class, and the corpus itself "
            "contains identical feature vectors bearing different labels. The "
            "limiting factor is not the architecture of the network but the "
            "separability of the classes in the feature space available, and no "
            "hyperparameter search can address that."))
    A(("p", "Section 4.7 supplies the sharpest evidence for this. Raising the "
            "class cap from 20,000 to 200,000 records, a preprocessing decision "
            "that touches no hyperparameter at all, reduced the benign "
            "false-alarm rate from 0.4788 to 0.2938. That single change to how "
            "the data was sampled improved the model's operational behaviour by "
            "considerably more than 110 network trainings had. Where a "
            "sampling decision outweighs the entire architecture search, the "
            "conclusion that the problem is data-limited rather than "
            "model-limited is difficult to avoid."))
    A(("p", "The defensible conclusion is therefore narrower and more useful "
            "than the one originally proposed: evolutionary hyperparameter "
            "optimisation converges rapidly to a competitive configuration for "
            "deep-learning-based intrusion detection, but on this dataset the "
            "binding constraint is the data rather than the model, and the "
            "search consequently has very little room in which to operate. "
            "Establishing whether a problem is architecture-limited before "
            "committing to an extended search is itself a worthwhile practice, "
            "and the convergence curve together with a confusion analysis "
            "provides a cheap way of doing so."))
    A(("p", "A secondary conclusion concerns evaluation. The macro "
            "false-positive rate, the measure this literature reports as a "
            "matter of course, recorded 0.0072 for a model that misclassifies "
            "29.4 per cent of all benign traffic. Reported alone it would have "
            "concealed the model's central weakness entirely. More seriously, "
            "the two models compared in Section 4.7 are ranked in opposite "
            "orders by macro F1 and by the benign false-alarm rate, so the "
            "choice of metric decides which model is judged the better one. Any "
            "evaluation of a multi-class intrusion detector should report the "
            "false-alarm rate on benign traffic directly rather than relying on "
            "a macro average across classes to represent it."))

    A(("h2", "5.3 \tLimitations"))
    A(("p", "Several limitations bear on how far these results should be "
            "carried."))
    A(("p", "The population size of ten sits well below the guidance of "
            "roughly ten members per dimension, which would indicate sixty for "
            "a six-dimensional space. This was a compute constraint rather "
            "than a design preference. A larger population would give the "
            "search more diversity, though the flatness established in Section "
            "4.5 makes a substantially different outcome unlikely."))
    A(("p", "The deduplicated build of the dataset excludes the destination "
            "port, which carries genuine protocol signal. The model was "
            "trained without it, and its performance on the brute-force "
            "classes in particular might differ had it been available."))
    A(("p", "Three attack classes were excluded as too small to evaluate, so "
            "the results describe a twelve-class problem rather than the "
            "fifteen classes present in the corpus. Results on the "
            "deduplicated build are also systematically lower than the "
            "published figures obtained on the original release, where "
            "duplicate flows appear in both the training and test partitions, "
            "and the two are therefore not directly comparable."))
    A(("p", "Finally, the class-aware cap rebalances the test partition, so "
            "the reported accuracy and false-positive rate are measured on a "
            "distribution that does not carry the eighty per cent benign prior "
            "of live traffic. The macro-averaged measures are unaffected."))

    A(("h2", "5.4 \tRecommendations"))
    A(("p", "The findings point clearly towards the data rather than the model, "
            "and the recommendations follow that direction."))
    A(("p", "Work on features rather than architecture. The Benign and "
            "Infiltration classes are not separable in the summary statistics "
            "CICFlowMeter produces. Representations that retain more of the "
            "structure of a flow, such as packet-sequence or payload-derived "
            "features, address the actual constraint; further architecture "
            "search does not."))
    A(("p", "Price false alarms explicitly. A benign flow misclassified as an "
            "attack and an attack misclassified as benign carry very different "
            "operational costs, and the loss function used here treats them "
            "identically. Cost-sensitive training, or an explicit adjustment of "
            "the decision threshold, would allow the trade-off to be set "
            "deliberately rather than inherited by default."))
    A(("p", "Report the benign false-alarm rate as standard. The evidence in "
            "Section 4.6 is that a macro-averaged false-positive rate can "
            "conceal a catastrophic benign misclassification rate in a "
            "multi-class setting. This costs nothing to compute and should "
            "accompany any such evaluation."))
    A(("p", "State the dataset build. Results obtained on deduplicated and "
            "non-deduplicated versions of CSE-CIC-IDS2018 differ "
            "systematically and are not comparable. Any published result on "
            "this dataset should say which was used, and the duplication rates "
            "reported in Chapter Four suggest that a systematic study of how "
            "much published performance on this benchmark is attributable to "
            "duplicate leakage would be a worthwhile contribution in itself."))
    A(("p", "Extend the search only where it is warranted. If the approach is "
            "applied to a dataset where the classes are genuinely separable, a "
            "population of sixty and a wider search space taking in optimiser "
            "choice, layer-wise widths and learning-rate schedules would give "
            "Differential Evolution considerably more to work with than it "
            "found here."))
    return S
