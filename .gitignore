data/*
!data/README.md
!data/.gitkeep
*.csv
!results/confusion_matrix.csv

# --- Run artefacts -----------------------------------------------------------
results/*.keras
results/*.h5
*.pkl
*.joblib

# --- Python ------------------------------------------------------------------
__pycache__/
*.py[cod]
*.egg-info/
.ipynb_checkpoints/
venv/
.venv/
env/

# --- Editors / OS ------------------------------------------------------------
.DS_Store
.vscode/
.idea/
*.swp
